    "@babel/preset-typescript": "^7.22.5",
    "@emotion/jest": "^11.11.0",
    "@indeed/a11y-highlander-jest": "^2.1.4",
    "@indeed/a11y-highlander-types": "^2.1.5",
    "@indeed/browserslist-config-frontend": "^1.9.0",
    "@indeed/common-npm-scripts-core": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-build": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-create-deploy-bundle": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-extract-i18n": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-generate-i18n-js": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-lint-styles": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-lint-ts": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-start-dev-server": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-test": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-ts-build": "^21.0.9",
    "@indeed/common-npm-scripts-plugin-ts-check": "^21.0.9",
    "@indeed/eslint-plugin-indeed": "^19.1.3",
    "@indeed/frontend-build": "^20.2.118",
    "@indeed/node-tiered-config": "^2.6.6",
    "@prettier/sync": "^0.6.0",
    "@storybook/addon-actions": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/cli": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-webpack5": "8.6.18",
    "@storybook/testing-library": "^0.2.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/koa-bodyparser": "^4.3.10",
    "@types/koa-logger": "^3.1.2",
    "@types/koa-mount": "^4.0.2",
    "@types/koa-static": "^4.0.2",
    "@types/koa__router": "^12.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest-allure2-adapter": "^0.3.12",
    "jest-environment-jsdom": "^29.7.0",
    "jest-jasmine2": "^29.7.0",
    "jest-junit": "^16.0.0",
    "postcss": "^8.5.10",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.6.2",
    "storybook": "8.6.18",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.88.2",
    "webpack-assets-manifest": "^6.0.0"
  }
}
