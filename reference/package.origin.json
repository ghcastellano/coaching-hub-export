{
  "name": "scrum-maturity-dashboard-marvin",
  "version": "1.0.0",
  "description": "Scrum Maturity Dashboard Marvin",
  "private": true,
  "main": "dist/server/index.js",
  "files": [
    "src",
    "dist",
    "config",
    "i18n.config.js"
  ],
  "scripts": {
    "build-storybook": "storybook build -o public -c .storybook",
    "bundle-ci-deployable": "pnpm run build && cns create-deploy-bundle --appname=scrum-maturity-dashboard-marvin",
    "build": "pnpm run clean && NODE_ENV=production cns build && cns ts-build --project tsconfig.build.json",
    "check": "cns ts-check",
    "clean": "rm -rf dist",
    "db:local:up": "docker compose -f local/docker-compose.yml up -d",
    "db:local:down": "docker compose -f local/docker-compose.yml down",
    "db:local:clone": "scripts/clone-prod-db.sh",
    "start:dev:localdb": "DATABASE_URL=postgresql://scrum-maturity-dash-rw:localdev@localhost:5432/scrum_maturity_dash DB_BOOTSTRAP_SCHEMA=1 pnpm run start:dev",
    "create-deploy-bundle": "pnpm install && pnpm run build && cns create-deploy-bundle --appname=scrum-maturity-dashboard-marvin",
    "extract-i18n": "cns extract-i18n i18n.config.js",
    "gen-i18n-js": "cns generate-i18n-js i18n.config.js",
    "prehobo-run": "docker compose -f hobo/docker-compose.yml down && if [[ -x hobo/pre-hobo-run.sh ]]; then hobo/pre-hobo-run.sh; fi",
    "hobo-run": "docker compose -f hobo/docker-compose.yml up -d",
    "hobo-stop": "docker compose -f hobo/docker-compose.yml down",
    "posthobo-stop": "if [[ -x hobo/post-hobo-stop.sh ]]; then hobo/post-hobo-stop.sh; fi",
    "lint": "cns lint-ts src",
    "lint:fix": "pnpm run lint -- --fix",
    "lint-styles": "cns lint-styles 'src/**/*.scss'",
    "postinstall": "node-git-version || true",
    "start": "node dist/server/index.js",
    "start:dev": "WEBPACK_LOCALHOST=1 concurrently -c green,blue,yellow -n daemon,bundle-client,bundle-server npm:start:dev:daemon npm:start:dev:bundle-client npm:start:dev:bundle-server",
    "start:dev:daemon": "STAGING_LEVEL=local ts-node-dev --inspect -- ./src/server/index.ts",
    "start:dev:bundle-client": "cns build --config webpack.client.js --watch --progress",
    "start:dev:bundle-server": "cns build --config webpack.server.js --watch --progress",
    "storybook": "storybook dev",
    "test": "cns test",
    "test:watch": "cns test --watch --no-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@code.corp.indeed.com:scrum-maturity-reports/scrum-maturity-dashboard-marvin.git"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.27.0",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@indeed/daemon": "^12.7.5",
    "@indeed/ifl-components": "^7.0.1",
    "@indeed/ifl-icons": "^7.0.1",
    "@indeed/indeed-gettext": "^7.0.0",
    "@indeed/logger": "^3.0.51",
    "@indeed/metrics": "^8.2.0",
    "@indeed/node-config": "^1.0.2",
    "@indeed/node-error-middleware": "^1.2.3",
    "@indeed/node-i18n-middleware": "^4.2.5",
    "@indeed/node-renderer": "^3.0.2",
    "@indeed/node-renderer-middleware": "^5.0.0",
    "@indeed/node-static-asset-middleware": "^4.4.5",
    "@indeed/ops": "^1.2.3",
    "@koa/router": "^14.0.0",
    "axios": "^1.15.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "koa": "^3.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-compose": "^4.1.0",
    "koa-logger": "^4.0.0",
    "koa-mount": "^4.0.0",
    "koa-static": "^5.0.0",
    "pg": "^8.20.0",
    "react": "^18.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.0.0",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.10",
